# API keys for the free-tier STORM setup.
#
# Copy this file to secrets.toml and fill in whichever keys you have:
#     cp secrets.toml.example secrets.toml
#
# secrets.toml is gitignored and is never committed.  Every key below is
# optional: the pipeline skips any provider whose key is missing and moves on
# to the next one in the fallback chain.  At least one key is required — every
# provider here is a hosted API, so there is no local model to fall back on.
#
# None of these require a credit card.

# -- Groq --------------------------------------------------------------------
# Free plan, ~30 requests/min on free models.
# Sign up: https://console.groq.com/keys
GROQ_API_KEY = ""

# -- Google Gemini ----------------------------------------------------------
# Free tier via AI Studio.
# Sign up: https://aistudio.google.com/apikey
# (GOOGLE_API_KEY also works if you already have one set.)
GEMINI_API_KEY = ""

# -- Mistral -----------------------------------------------------------------
# Free mode, no card required.
# Sign up: https://console.mistral.ai/api-keys
MISTRAL_API_KEY = ""

# -- OpenRouter --------------------------------------------------------------
# Free models, but only ~50 requests/day, so treat it as a last resort.
# Sign up: https://openrouter.ai/keys
OPENROUTER_API_KEY = ""

# -- NVIDIA NIM --------------------------------------------------------------
# Free credits on signup.
# Sign up: https://build.nvidia.com
NVIDIA_NIM_API_KEY = ""

# -- Cohere ------------------------------------------------------------------
# Trial key, no card.  1,000 calls/month, 20 requests/min.
# Sign up: https://dashboard.cohere.com/api-keys
COHERE_API_KEY = ""

# -- AI21 Studio -------------------------------------------------------------
# Trial key on signup, no card.
# Sign up: https://studio.ai21.com
AI21_API_KEY = ""

# -- Galadriel ---------------------------------------------------------------
# Free credits on signup.
# Sign up: https://galadriel.ai
GALADRIEL_API_KEY = ""

# -- Nebius AI Studio --------------------------------------------------------
# Free credits on signup.
# Sign up: https://studio.nebius.ai
NEBIUS_API_KEY = ""

# -- DeepInfra ---------------------------------------------------------------
# Free credits on signup.
# Sign up: https://deepinfra.com
DEEPINFRA_API_KEY = ""

# -- Hugging Face ------------------------------------------------------------
# Free credits on signup.  A read token is enough.
# Sign up: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY = ""

# -- OVHcloud AI Endpoints ---------------------------------------------------
# Anonymous access is allowed, so a key is optional.
# Sign up: https://endpoints.ai.cloud.ovh.net
OVH_API_KEY = ""

# -- Meta Llama API ----------------------------------------------------------
# Free tier, no card.
# Sign up: https://llama.developer.meta.com
LLAMA_API_KEY = ""

# -- Fireworks AI ------------------------------------------------------------
# Free credits on signup.
# Sign up: https://fireworks.ai/api-keys
FIREWORKS_AI_API_KEY = ""

# -- Hyperbolic --------------------------------------------------------------
# Free credits on signup.
# Sign up: https://app.hyperbolic.xyz/
HYPERBOLIC_API_KEY = ""

# -- Novita ------------------------------------------------------------------
# Free credits on signup.
# Sign up: https://novita.ai/dashboard
NOVITA_API_KEY = ""

# -- DeepSeek ----------------------------------------------------------------
# Signup credits, then per-token billing.
# Sign up: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY = ""

# -- SambaNova ---------------------------------------------------------------
# Free developer tier.
# Sign up: https://cloud.sambanova.ai/
SAMBANOVA_API_KEY = ""

# -- Together AI -------------------------------------------------------------
# Free credits on signup.
# Sign up: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY = ""

# -- Perplexity --------------------------------------------------------------
# Some free API requests.
# Sign up: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY = ""

# -- xAI ---------------------------------------------------------------------
# Free credits on signup.
# Sign up: https://console.x.ai/
XAI_API_KEY = ""

# -- Cerebras ----------------------------------------------------------------
# Trial credits, but a verified payment method is now required.
# Sign up: https://cloud.cerebras.ai
CEREBRAS_API_KEY = ""

# -- Retriever keys (optional) ----------------------------------------------
# The default retriever is DuckDuckGo, which needs NO key.  Only fill these
# in if you want a different search backend.
#
# Bing:        https://azure.microsoft.com/free/ (Bing Search)
# Brave:       https://brave.com/search/api/
# Serper:      https://serper.dev/
# Tavily:      https://tavily.com/
# You.com:     https://you.com/api
# SearXNG:     self-hosted, no signup
BING_SEARCH_API_KEY = ""
BRAVE_API_KEY = ""
SERPER_API_KEY = ""
TAVILY_API_KEY = ""
YDC_API_KEY = ""
SEARXNG_API_KEY = ""
GOOGLE_API_KEY = ""
